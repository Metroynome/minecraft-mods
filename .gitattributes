# Normalize text files and keep repository line endings predictable.
* text=auto

# Source, build, and config files should use LF in Git.
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.groovy text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.mcmeta text eol=lf
*.accesswidener text eol=lf

# Shell scripts need LF; Windows batch files should keep CRLF.
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common assets and generated artifacts as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.jar binary
*.zip binary
*.gz binary
*.class binary
